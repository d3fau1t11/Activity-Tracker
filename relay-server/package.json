{
  "name": "activity-tracker-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check netlify/functions/telegram.mjs && node --check netlify/functions/retry-deliveries.mjs && node --check netlify/functions/upload-image.mjs",
    "configure": "node --env-file=.env scripts/configure.mjs",
    "check:env": "node --env-file=.env scripts/check-environment.mjs",
    "bundle:check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.8",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "rimraf": "^6.1.4",
    "@vercel/nft": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "@netlify/zip-it-and-ship-it": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.6.0"
  }
}
