# Add these two preset values through the Netlify Environment variables UI.
# Netlify Free uses All scopes. PCs register automatically with the bot credential.
TELEGRAM_BOT_TOKEN=your-existing-bot-token
TELEGRAM_CHAT_ID=your-private-user-chat-id
# Optional kill switch: set false on Netlify to reject the PC and stop retries.
# RELAY_ENABLED=false

# Local configure script only: your deployed HTTPS origin.
RELAY_SITE_URL=https://your-site.netlify.app
