  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <Compile Include="../Relay/RelaySettings.cs;../Relay/RelayOutbox.cs;../Relay/RelayTransport.cs;../Relay/WebpImages.cs" Link="Relay/%(Filename)%(Extension)" />
