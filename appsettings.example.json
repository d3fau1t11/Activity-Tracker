{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Telegram": {
    "BotToken": "YOUR_BOT_TOKEN",
    "ChatId": "YOUR_CHAT_ID",
    "EnablePrivacyMode": false,
    "TimeoutSeconds": 30
  },
  "Relay": {
    "Enabled": false,
    "BaseUrl": "https://YOUR-SITE.netlify.app",
    "SharedBot": true,
    "DeviceId": "auto",
    "PollSeconds": 60,
    "DirectTimeoutSeconds": 8,
    "RecoverySeconds": 60,
    "LocalRetentionDays": 7
  },
  "Worker": {
    "CheckIntervalSeconds": 2,
    "MinSessionDurationSeconds": 15,
    "IdleThresholdSeconds": 180,
    "IgnoreSystemProcesses": true,
    "IgnoreProcesses": []
  },
  "DailyDigest": {
    "Enabled": true,
    "SendAt": "08:00",
    "SendEmptyDays": false
  },
  "Privacy": {
    "HashWindowTitles": false,
    "RemoveSensitiveKeywords": true,
    "SensitiveKeywords": ["password", "bank", "credit card", "ssn", "social security", "login", "sign in"]
  }
}
